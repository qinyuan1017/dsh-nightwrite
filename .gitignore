# ── 依赖 ────────────────────────────────────────────────
node_modules/

# ── 构建产物（唯一：由 build.mjs 拼出来）────────────────
# 注意：lib/*.js 里只有 client.js 是产物，其余 25 个模块都是源码，必须入库。
lib/client.js
lib/client.js.*

# ── 备份 / 临时 ─────────────────────────────────────────
*.bak-*
.bak-*/
.tmpwork/
*.tmp

# ── 测试临时脚本（下划线开头的都是排查用的，不是测试）──
test/_*.mjs
test/_*.js

# ── 长夜的数据目录（CHANGYE_ROOT 默认落在 ~/.dsh/data/dsh-changye，
#    如果有人把 CHANGYE_ROOT 指到仓库里，别把书稿和账本提交进来）──
.changye-data/
data/
projects/

# ── 编辑器 / 系统 ───────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── 日志 ────────────────────────────────────────────────
*.log
npm-debug.log*
