# ── 依赖 ────────────────────────────────────────────────
node_modules/

# ── 构建产物 ────────────────────────────────────────────
# lib/*.js 里只有 client.js 是产物，其余 25 个模块都是源码。
# client.js **必须入库**：它是插件的运行产物，宿主按 ./client 导出直接取这个文件，
# 仓库里没有它 = 装下来白屏（构建在 CI 里做，不做在安装时，因为宿主不跑 postinstall）。
# 防漂移靠 CI 的「build 后 git diff --exit-code lib/client.js」这一步。
lib/client.js.*

# ── 备份 / 临时 ─────────────────────────────────────────
*.bak-*
.bak-*/
.tmpwork/
*.tmp

# ── 测试临时脚本（下划线开头的都是排查用的，不是测试）──
test/_*.mjs
test/_*.js

# ── 长夜的数据目录（NIGHTWRITE_ROOT 默认落在 ~/.dsh/data/dsh-nightwrite，
#    如果有人把 NIGHTWRITE_ROOT 指到仓库里，别把书稿和账本提交进来）──
.nightwrite-data/
data/
projects/

# ── 编辑器 / 系统 ───────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── 日志 ────────────────────────────────────────────────
*.log
npm-debug.log*
